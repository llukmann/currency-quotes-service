# Application variables. The values below mirror the defaults hardcoded in
# docker-compose.yml; this file is only needed to override them locally.
# Copying it to .env is not required to run the stack.

# HTTP server port
HTTP_PORT=8080

# HTTP server timeouts
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s

# How long to wait for in-flight requests to finish on shutdown
SHUTDOWN_TIMEOUT=10s

# debug | info | warn | error
LOG_LEVEL=info
