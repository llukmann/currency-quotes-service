# Local overrides for the values docker-compose.yml already defaults to.
# Copying this file to .env is optional: the stack runs without it.
# What each value means is in internal/config/config.go, not repeated here.

# The only variable with no default. The host is the one inside the compose
# network; POSTGRES_PORT only says where the database is published on the host.
# A password containing @ : or / must be percent-encoded. pgx reads
# pool_max_conns from this string too, so the pool has no variable of its own.
DATABASE_URL=postgres://quotes:quotes@postgres:5432/quotes?sslmode=disable

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
# The deadline of a single request is derived from this one, a second less, so
# that a handler which runs out of time can still write its answer. A write
# timeout leaving nothing above that second is refused at startup.
HTTP_WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

# debug | info | warn | error
LOG_LEVEL=info

# Scheme and host only: the path belongs to the client.
PROVIDER_BASE_URL=https://api.frankfurter.dev
# Timeout of one attempt, attempts in total, and the pause before the second,
# which doubles before each attempt after it and is spread over a window
# around itself.
PROVIDER_TIMEOUT=3s
PROVIDER_ATTEMPTS=3
PROVIDER_BACKOFF=200ms

WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=1s
WORKER_TASK_TIMEOUT=15s
# Measured against the database clock while the task deadline above is measured
# by the service, so it has to carry a margin: at least twice the deadline, or
# the service refuses to start.
WORKER_STUCK_TIMEOUT=60s
WORKER_RECOVERY_INTERVAL=30s
WORKER_MAX_ATTEMPTS=3

# How long an Idempotency-Key stays bound to the task it was answered with.
# Nothing deletes an expired binding: the lookup stops seeing it, and the next
# post carrying that key takes the row over.
IDEMPOTENCY_TTL=1h

# The storage tests, and the only variable here the service never reads. Unset
# -- the state of a clean clone -- those tests skip themselves. They truncate
# every table between cases, so this must not be the database the service runs
# against.
#
# Applying the migrations is a step of its own: the tests check that the schema
# is there and stop if it is not. With the stack up:
#
#   docker compose exec postgres createdb -U quotes quotes_test
#   docker compose run --rm migrate -path=/migrations `
#     -database "postgres://quotes:quotes@postgres:5432/quotes_test?sslmode=disable" up
#   $env:TEST_DATABASE_URL = "postgres://quotes:quotes@localhost:5432/quotes_test?sslmode=disable"
TEST_DATABASE_URL=
