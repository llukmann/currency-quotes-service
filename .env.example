# Application variables. The values below mirror the defaults hardcoded in
# docker-compose.yml; this file is only needed to override them locally.
# Copying it to .env is not required to run the stack.

# PostgreSQL connection string. The only variable without a default: the
# service refuses to start rather than connect to some arbitrary fallback.
# A password containing @ : or / must be percent-encoded.
# Note the port is the one inside the compose network, not POSTGRES_PORT,
# which only says where the database is published on the host.
# The connection pool is sized from this string as well: pgx reads
# pool_max_conns from it, and defaults to the greater of 4 and the CPU count.
# It has no variable of its own, so that the whole database setup stays here.
DATABASE_URL=postgres://quotes:quotes@postgres:5432/quotes?sslmode=disable

# HTTP server port
HTTP_PORT=8080

# HTTP server timeouts. The deadline of a single request is derived from the
# write timeout rather than set on its own: it is that value less one second,
# kept back so that a handler which runs out of time can still write its 500
# before the server stops writing at all. A write timeout that leaves nothing
# above the second is refused at startup.
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s

# How long to wait for in-flight requests to finish on shutdown
SHUTDOWN_TIMEOUT=10s

# debug | info | warn | error
LOG_LEVEL=info

# Rate provider. The scheme and host only: the path belongs to the client.
PROVIDER_BASE_URL=https://api.frankfurter.dev

# Timeout of a single HTTP attempt, the total number of attempts, and the pause
# before the second one, which doubles before every attempt after it and is
# spread over a window around itself. Together they bound one provider call:
# 3 x 3s of requests plus at most 0.3s and 0.6s of waiting, just under 10s.
PROVIDER_TIMEOUT=3s
PROVIDER_ATTEMPTS=3
PROVIDER_BACKOFF=200ms

# How many tasks the worker pool processes at once, and how long a worker waits
# before asking an empty queue again.
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=1s

# Deadline of a single task, covering the whole path from the claim to the
# finalising commit: the provider call with all of its retries, and the
# database work after it. It must exceed the provider budget above, and the
# service refuses to start if it does not.
WORKER_TASK_TIMEOUT=15s

# How long a task may sit in in_progress before the recovery pass takes it
# back, and how often that pass runs. The threshold is measured against the
# database clock while the deadline above is measured by the service, so it
# must be at least twice the deadline -- again checked at startup.
WORKER_STUCK_TIMEOUT=60s
WORKER_RECOVERY_INTERVAL=30s

# How many times a task may be claimed before the recovery pass gives up on it
# and closes it as failed instead of releasing it once more.
WORKER_MAX_ATTEMPTS=3

# How long the binding between an Idempotency-Key and its task stays valid.
# Nothing deletes an expired binding: the lookup stops seeing it, and the next
# post carrying that key takes the row over. The threshold is deliberately
# shorter than the conventional 24 hours, since it is also the longest a post
# can silently perform no update at all.
IDEMPOTENCY_TTL=1h

# Database the storage tests run against, and the only variable here that the
# service itself never reads. Unset -- which is the default, and the state of a
# clean clone -- those tests skip themselves and `go test ./...` covers
# everything else; set, they exercise the SQL against a real PostgreSQL, which
# is the only thing that can answer for what the statements actually do.
#
# The tests truncate every table between cases, so this must not be the
# database the service is running against. With the compose stack up, create a
# database beside it and point this at the published port:
#
#   docker compose exec postgres createdb -U quotes quotes_test
#   $env:TEST_DATABASE_URL = "postgres://quotes:quotes@localhost:5432/quotes_test?sslmode=disable"
#
# The schema is prepared by the tests themselves: they run the migrations
# before the first case, so an empty database is enough.
TEST_DATABASE_URL=
